<?xml version="1.0" encoding="utf-8"?>
<!--
  项目内的 NuGet 配置。

  这台机器的用户级 NuGet.config 里 packageSources 是空的，没有可用源，
  而自包含发布需要从 nuget.org 还原 Windows 运行时包。
  这里只在项目范围内补一个源，不修改全局配置；删掉本文件后，
  构建脚本会自动退回免依赖框架的发布方式。

  如果你的环境要求走内网镜像，把 nuget.org 换成对应的镜像地址即可。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>