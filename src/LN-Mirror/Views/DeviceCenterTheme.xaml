<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="CenterFrame" Color="#FFF2F5F8"/>
    <SolidColorBrush x:Key="CenterSurface" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CenterSoft" Color="#FFF7F9FB"/>
    <SolidColorBrush x:Key="CenterLine" Color="#FFE0E6EC"/>
    <SolidColorBrush x:Key="CenterControlLine" Color="#FFBBC5D0"/>
    <SolidColorBrush x:Key="CenterInk" Color="#FF172434"/>
    <SolidColorBrush x:Key="CenterMuted" Color="#FF516173"/>
    <SolidColorBrush x:Key="CenterSelection" Color="#FFE4EAF0"/>
    <SolidColorBrush x:Key="CenterAccent" Color="#FF1558A6"/>

    <Style x:Key="CenterPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1"/>
    </Style>
    <Style x:Key="CenterSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
    </Style>
    <Style x:Key="CenterNote" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource CenterMuted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="CenterPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CenterSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CenterLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="CenterAction" TargetType="Button">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="11,6"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource CenterInk}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource CenterSelection}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Face" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource CenterAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#FF627181"/>
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource CenterSoft}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CenterPrimary" TargetType="Button" BasedOn="{StaticResource CenterAction}">
        <Setter Property="Background" Value="{StaticResource CenterInk}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#FF2F4256"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource CenterSelection}"/>
                            <Setter Property="Foreground" Value="{StaticResource CenterMuted}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CenterOutline" TargetType="Button" BasedOn="{StaticResource CenterAction}">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource CenterControlLine}"/>
    </Style>

    <Style x:Key="CenterField" TargetType="Control">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource CenterInk}"/>
        <Setter Property="Background" Value="{StaticResource CenterSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CenterLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="CenterFieldText" TargetType="TextBox" BasedOn="{StaticResource CenterField}">
        <Setter Property="CaretBrush" Value="{StaticResource CenterInk}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource CenterSelection}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Field" CornerRadius="7" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource CenterControlLine}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Field" Property="Background" Value="{StaticResource CenterSurface}"/>
                            <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource CenterAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource CenterMuted}"/>
                            <Setter TargetName="Field" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CenterFieldToggle" TargetType="ToggleButton" BasedOn="{StaticResource CenterField}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Field" CornerRadius="7" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" ClipToBounds="True" IsHitTestVisible="False"/>
                            <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource CenterMuted}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" VerticalAlignment="Center" Margin="8,0,1,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource CenterControlLine}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Field" Property="Background" Value="{StaticResource CenterSelection}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource CenterAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource CenterMuted}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                            <Setter TargetName="Field" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CenterFieldMenu" TargetType="Border" BasedOn="{StaticResource CenterPanel}">
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="CenterFieldMenuButton" TargetType="Button" BasedOn="{StaticResource CenterAction}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="CenterFieldOption" TargetType="ComboBoxItem">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Foreground" Value="{StaticResource CenterInk}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="9,4">
                        <DockPanel>
                            <Path x:Name="SelectedMark" DockPanel.Dock="Right" Data="M 0,4 L 3,7 L 9,1"
                                  Stroke="{StaticResource CenterAccent}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Hidden"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource CenterSoft}"/>
                            <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource CenterSelection}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource CenterMuted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CenterFieldCombo" TargetType="ComboBox" BasedOn="{StaticResource CenterField}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource CenterFieldOption}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="DropDownToggle" Style="{StaticResource CenterFieldToggle}"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                      Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" VerticalOffset="4">
                            <Border Style="{StaticResource CenterFieldMenu}" MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer CanContentScroll="True">
                                    <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{StaticResource CenterAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CenterNav" TargetType="TabItem">
        <Setter Property="DockPanel.Dock" Value="Top"/>
        <Setter Property="Foreground" Value="{StaticResource CenterMuted}"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Face" CornerRadius="6" Background="Transparent" Padding="12,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="16" Height="16" Stretch="Uniform" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Margin="0,0,10,0"/>
                            <ContentPresenter x:Name="Label" ContentSource="Header" RecognizesAccessKey="True"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource CenterSoft}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource CenterSelection}"/>
                            <Setter Property="Foreground" Value="{StaticResource CenterInk}"/>
                            <Setter TargetName="Label" Property="TextElement.FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CenterTopNav" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource CenterMuted}"/>
        <Setter Property="MinWidth" Value="104"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Face" CornerRadius="7" Background="Transparent" Padding="14,0" Cursor="Hand">
                        <Grid>
                            <ContentPresenter x:Name="Label" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            <Border x:Name="Indicator" Height="2" Width="28" CornerRadius="1" VerticalAlignment="Bottom"
                                    Background="{StaticResource CenterAccent}" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource CenterSoft}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource CenterInk}"/>
                            <Setter TargetName="Label" Property="TextElement.FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CenterMode" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource CenterMuted}"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="Margin" Value="0,0,16,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <ContentPresenter RecognizesAccessKey="True" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        <Border x:Name="Indicator" Height="2" VerticalAlignment="Bottom" Background="Transparent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource CenterInk}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Indicator" Property="Background" Value="{StaticResource CenterAccent}"/>
                            <Setter Property="Foreground" Value="{StaticResource CenterInk}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CenterAppWindowRow" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="MinHeight" Value="54"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Face" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}"
                            BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource CenterSoft}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource CenterSelection}"/>
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource CenterControlLine}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CenterDeviceRow" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Face" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Ellipse x:Name="SelectedMark" DockPanel.Dock="Right" Width="8" Height="8" VerticalAlignment="Center"
                                     Stroke="{StaticResource CenterMuted}" Margin="8,0,0,0"/>
                            <Path DockPanel.Dock="Left" Data="M 5,1 H 13 Q 15,1 15,3 V 16 Q 15,18 13,18 H 5 Q 3,18 3,16 V 3 Q 3,1 5,1 M 7,15 H 11"
                                  Width="13" Height="16" Stretch="Uniform" Stroke="{StaticResource CenterMuted}" StrokeThickness="1.4"
                                  VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource CenterSoft}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource CenterSelection}"/>
                            <Setter TargetName="SelectedMark" Property="Stroke" Value="{StaticResource CenterAccent}"/>
                            <Setter TargetName="SelectedMark" Property="Fill" Value="{StaticResource CenterAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CenterQuickToggle" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource CenterInk}"/>
        <Setter Property="Background" Value="{StaticResource CenterSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CenterControlLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Face" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource CenterSelection}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource CenterAccent}"/>
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource CenterAccent}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CenterDisclosure" TargetType="Expander">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Content="{TemplateBinding Header}" Foreground="{StaticResource CenterInk}" FontWeight="SemiBold">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Face" CornerRadius="6" Background="Transparent" Padding="2,9">
                                        <DockPanel>
                                            <Path x:Name="Arrow" DockPanel.Dock="Right" Data="M 2,1 L 6,5 L 2,9"
                                                  Stroke="{StaticResource CenterMuted}" StrokeThickness="1.25"
                                                  Width="7" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="Data" Value="M 1,2 L 5,6 L 9,2"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Face" Property="Background" Value="{StaticResource CenterSoft}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Details" ContentSource="Content" Visibility="Collapsed"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Details" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CenterSettingCheck" TargetType="CheckBox">
        <Setter Property="MinHeight" Value="37"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Row" Background="Transparent" BorderBrush="{StaticResource CenterLine}"
                            BorderThickness="0,0,0,1" Padding="0,6">
                        <DockPanel>
                            <Border x:Name="Indicator" DockPanel.Dock="Right" Height="16" Width="16" CornerRadius="3"
                                    VerticalAlignment="Center" Margin="10,0,0,0" BorderThickness="1"
                                    BorderBrush="{StaticResource CenterControlLine}" Background="{StaticResource CenterSurface}">
                                <Path x:Name="Mark" Data="M 3,8 L 6,11 L 12,4" Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter ContentSource="Content" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource CenterSoft}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Indicator" Property="Background" Value="{StaticResource CenterAccent}"/>
                            <Setter TargetName="Indicator" Property="BorderBrush" Value="{StaticResource CenterAccent}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Row" Property="Opacity" Value="0.65"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CenterSlider" TargetType="Slider">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="SliderSurface" Background="Transparent">
                        <Border Height="4" VerticalAlignment="Center" Background="{StaticResource CenterSelection}" CornerRadius="2"/>
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <Border Height="4" VerticalAlignment="Center" CornerRadius="2"
                                                        Background="{StaticResource CenterAccent}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource CenterAccent}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
