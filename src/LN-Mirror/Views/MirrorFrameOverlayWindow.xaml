<Window x:Class="LNMirror.Views.MirrorFrameOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Focusable="False"
        ShowActivated="False"
        Title="LN-Mirror 悬停边框">

    <!--
      画面上方的覆盖层，三件事：
      1. 画面可见且鼠标移上去时，在四条边中段和四个角显示拖动/缩放把手；
      2. 画面完全看不见时，按用户选择画一个位置提示（淡边框或角标）；
      3. 中间区域不渲染内容，点击直接穿透到 scrcpy。
      提示元素一律 IsHitTestVisible=False，不挡画面与下层窗口的点击。
    -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
        </Grid.ColumnDefinitions>

        <!-- 位置提示：淡边框 -->
        <Rectangle x:Name="HintOutline" Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Grid.ColumnSpan="3"
                   Margin="1" RadiusX="2" RadiusY="2"
                   Stroke="#77909090" StrokeThickness="1" StrokeDashArray="5,4"
                   IsHitTestVisible="False" Visibility="Collapsed"/>

        <!-- 位置提示：角标 -->
        <Grid x:Name="HintCorner" Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Grid.ColumnSpan="3"
              IsHitTestVisible="False" Visibility="Collapsed">
            <Rectangle Height="2" Width="20" Fill="#77909090" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Rectangle Width="2" Height="20" Fill="#77909090" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </Grid>

        <!-- 拖动/缩放把手 -->
        <Grid x:Name="HandleLayer" Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Grid.ColumnSpan="3"
              Visibility="Collapsed">
            <Grid.Resources>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0.35"/>
                    <Setter Property="ForceCursor" Value="True"/>
                    <!-- 分层窗口由 Windows 按像素 alpha 命中：alpha=0 会直接穿到 scrcpy，
                         所以这里必须用非零 alpha 的近乎全透明黑，而不是 Transparent。
                         只有允许拖动的段有背景，其余区域仍可点穿到手机画面。 -->
                    <Setter Property="Background" Value="#10000000"/>
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="14"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
            </Grid.ColumnDefinitions>

            <!-- 顶边 / 底边：只保留水平中间三分之一 -->
            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="TopMoveHandle" Grid.Column="1" Tag="Move" Cursor="SizeAll"
                        MouseLeftButtonDown="OnHandleDown" MouseMove="OnHandleMove" LostMouseCapture="OnHandleLostCapture"
                        MouseLeftButtonUp="OnHandleUp" MouseEnter="OnHandleEnter" MouseLeave="OnHandleLeave">
                    <Rectangle Height="5" Fill="#73000000" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="BottomMoveHandle" Grid.Column="1" Tag="Move" Cursor="SizeAll"
                        MouseLeftButtonDown="OnHandleDown" MouseMove="OnHandleMove" LostMouseCapture="OnHandleLostCapture"
                        MouseLeftButtonUp="OnHandleUp" MouseEnter="OnHandleEnter" MouseLeave="OnHandleLeave">
                    <Rectangle Height="5" Fill="#73000000" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- 左边 / 右边：只保留垂直中间三分之一 -->
            <Grid Grid.Row="0" Grid.RowSpan="3" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="LeftMoveHandle" Grid.Row="1" Tag="Move" Cursor="SizeAll"
                        MouseLeftButtonDown="OnHandleDown" MouseMove="OnHandleMove" LostMouseCapture="OnHandleLostCapture"
                        MouseLeftButtonUp="OnHandleUp" MouseEnter="OnHandleEnter" MouseLeave="OnHandleLeave">
                    <Rectangle Width="5" Fill="#73000000" RadiusX="2" RadiusY="2" HorizontalAlignment="Center"/>
                </Border>
            </Grid>
            <Grid Grid.Row="0" Grid.RowSpan="3" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="RightMoveHandle" Grid.Row="1" Tag="Move" Cursor="SizeAll"
                        MouseLeftButtonDown="OnHandleDown" MouseMove="OnHandleMove" LostMouseCapture="OnHandleLostCapture"
                        MouseLeftButtonUp="OnHandleUp" MouseEnter="OnHandleEnter" MouseLeave="OnHandleLeave">
                    <Rectangle Width="5" Fill="#73000000" RadiusX="2" RadiusY="2" HorizontalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- 四角：拖动缩放。放在最后，保证 14×14 的角部命中优先于四边。 -->
            <Border x:Name="CornerNW" Grid.Row="0" Grid.Column="0" Tag="NW" Cursor="SizeNWSE"
                    MouseLeftButtonDown="OnHandleDown" MouseMove="OnHandleMove" LostMouseCapture="OnHandleLostCapture"
                    MouseLeftButtonUp="OnHandleUp" MouseEnter="OnHandleEnter" MouseLeave="OnHandleLeave">
                <Grid>
                    <Rectangle Height="5" Fill="#73000000" RadiusX="2" RadiusY="2" VerticalAlignment="Top"/>
                    <Rectangle Width="5" Fill="#73000000" RadiusX="2" RadiusY="2" HorizontalAlignment="Left"/>
                </Grid>
            </Border>
            <Border x:Name="CornerNE" Grid.Row="0" Grid.Column="2" Tag="NE" Cursor="SizeNESW"
                    MouseLeftButtonDown="OnHandleDown" MouseMove="OnHandleMove" LostMouseCapture="OnHandleLostCapture"
                    MouseLeftButtonUp="OnHandleUp" MouseEnter="OnHandleEnter" MouseLeave="OnHandleLeave">
                <Grid>
                    <Rectangle Height="5" Fill="#73000000" RadiusX="2" RadiusY="2" VerticalAlignment="Top"/>
                    <Rectangle Width="5" Fill="#73000000" RadiusX="2" RadiusY="2" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
            <Border x:Name="CornerSW" Grid.Row="2" Grid.Column="0" Tag="SW" Cursor="SizeNESW"
                    MouseLeftButtonDown="OnHandleDown" MouseMove="OnHandleMove" LostMouseCapture="OnHandleLostCapture"
                    MouseLeftButtonUp="OnHandleUp" MouseEnter="OnHandleEnter" MouseLeave="OnHandleLeave">
                <Grid>
                    <Rectangle Height="5" Fill="#73000000" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom"/>
                    <Rectangle Width="5" Fill="#73000000" RadiusX="2" RadiusY="2" HorizontalAlignment="Left"/>
                </Grid>
            </Border>
            <Border x:Name="CornerSE" Grid.Row="2" Grid.Column="2" Tag="SE" Cursor="SizeNWSE"
                    MouseLeftButtonDown="OnHandleDown" MouseMove="OnHandleMove" LostMouseCapture="OnHandleLostCapture"
                    MouseLeftButtonUp="OnHandleUp" MouseEnter="OnHandleEnter" MouseLeave="OnHandleLeave">
                <Grid>
                    <Rectangle Height="5" Fill="#73000000" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom"/>
                    <Rectangle Width="5" Fill="#73000000" RadiusX="2" RadiusY="2" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
