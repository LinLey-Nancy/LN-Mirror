                                                           AutomationProperties.Name="应用窗口显示方式说明"/>
                                        </StackPanel>
                                        <ComboBox Margin="0,10,0,0" Style="{StaticResource CenterFieldCombo}"
                                                  ItemsSource="{Binding Apps.DisplayModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Key"
                                                  SelectedValue="{Binding Apps.DisplayMode, Mode=TwoWay}" IsEnabled="{Binding Apps.IsManageEnabled}"
                                                  AutomationProperties.Name="应用窗口显示方式"/>
                                        <CheckBox IsChecked="{Binding Apps.KeepOnLeave, Mode=TwoWay}"
                                                  IsEnabled="{Binding Apps.IsManageEnabled}" Style="{StaticResource CenterSettingCheck}"
                                                  Visibility="{Binding Apps.UsesHover, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="移开仍显示" VerticalAlignment="Center"/>
                                                <views:HelpTip Text="当设置为“悬浮时显示”时，当鼠标移开界面仍保留显示，直到鼠标进行任意点击操作时才关闭。"
                                                               AutomationProperties.Name="移开仍显示说明"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <DockPanel Margin="0,12,0,0">
