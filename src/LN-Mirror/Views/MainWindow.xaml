                                        <TextBlock Text="{Binding PassThroughCheck}" Style="{StaticResource CenterNote}"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CenterPanel}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
