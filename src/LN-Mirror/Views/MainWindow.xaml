                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="当前窗口" Style="{StaticResource CenterPageTitle}" FontSize="20"/>
                                <Button Content="↻" HorizontalAlignment="Right" Width="36" Style="{StaticResource CenterAction}"
                                        AutomationProperties.Name="刷新窗口列表" Click="OnRefreshAppWindowsClick"/>
                            </Grid>
                            <Border Background="{StaticResource CenterSoft}" CornerRadius="7" Padding="8,6" DockPanel.Dock="Bottom" Margin="0,10,0,0">
