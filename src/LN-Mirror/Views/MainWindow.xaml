                                <TextBlock Text="{Binding Apps.StatusText}" Style="{StaticResource CenterNote}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding Apps.Notice}" Foreground="{StaticResource ErrBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>

                                <Border Style="{StaticResource CenterPanel}" Background="{StaticResource CenterSoft}" Padding="14" Margin="0,14,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
