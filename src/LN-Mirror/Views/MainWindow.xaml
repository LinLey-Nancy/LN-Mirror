                                                       AutomationProperties.Name="渲染后端说明"/>
                                        <ComboBox Style="{StaticResource CenterFieldCombo}" ItemsSource="{Binding RenderDriverOptions}" SelectedItem="{Binding RenderDriver}"
                                                  AutomationProperties.Name="渲染后端" HorizontalAlignment="Right" Width="166"/>
                                    </DockPanel>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="诊断">
                <TabItem.Tag><Geometry>M 1,9 H 5 L 8,2 L 11,16 L 14,9 H 17</Geometry></TabItem.Tag>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,20,24,20">
