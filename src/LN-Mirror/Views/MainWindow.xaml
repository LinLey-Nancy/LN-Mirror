                                <DockPanel Margin="0,5,0,0">
                                    <Button Content="验证鼠标穿透" DockPanel.Dock="Right" Style="{StaticResource CenterOutline}"
                                            Click="OnVerifyPassThroughClick" IsEnabled="{Binding PassThroughEnabled}" Margin="9,0,0,0"/>
