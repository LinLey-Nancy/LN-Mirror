                                                <Run Text="（Android 11 及以上）" FontSize="12" FontWeight="Normal" Foreground="{StaticResource CenterMuted}"/>
                                            </TextBlock>
                                            <TextBlock Text="1. 让手机和电脑接入同一局域网。在「开发者选项」中打开「无线调试」。"
                                                       Style="{StaticResource CenterNote}" FontSize="14" Margin="0,0,0,4"/>
