                </ScrollViewer>
            </TabItem>

            <TabItem Header="帮助" DockPanel.Dock="Bottom">
                <TabItem.Tag><Geometry>M 17,9 A 8,8 0 1 1 1,9 A 8,8 0 1 1 17,9 M 6,6 Q 7,3 10,4 Q 13,6 10,8 Q 9,9 9,11 M 9,13 V 14</Geometry></TabItem.Tag>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,20,24,20">
