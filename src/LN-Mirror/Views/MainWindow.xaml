<Window x:Class="LNMirror.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LN-Mirror 手机悬浮投屏"
        Width="1081" Height="1021" MinWidth="840" MinHeight="620"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="336"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左：连接设备 ============ -->
        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="连接设备" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <Border x:Name="PhaseStrip" DockPanel.Dock="Top" Background="#FFF0F0EE" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="PhaseText" Text="{Binding PhaseText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding PhaseHint}" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="当前设备" Style="{StaticResource SectionLabel}"/>
                        <ComboBox ItemsSource="{Binding Devices}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedDevice}"
                                  IsEnabled="{Binding CanConnect}"
                                  MinHeight="30" Padding="6,3"/>

                        <TextBlock Text="{Binding SelectedDeviceStateText}" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="连接方式" Style="{StaticResource SectionLabel}" Margin="0,16,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <RadioButton Content="USB 有线" GroupName="ConnectionMode" IsChecked="{Binding IsUsbMode}" Margin="0,0,16,0" VerticalContentAlignment="Center"/>
                            <RadioButton Content="局域网" GroupName="ConnectionMode" IsChecked="{Binding IsLanMode}" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- USB 分区 -->
                        <TextBlock Visibility="{Binding IsUsbMode, Converter={StaticResource BoolToVis}}"
                                   Style="{StaticResource SectionLabel}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="用数据线连接手机后，设备会出现在上方“当前设备”里。局域网连接切到右侧“局域网”页签。"/>

                        <!-- ============ 局域网分区 ============ -->
                        <StackPanel Visibility="{Binding IsLanMode, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">

                            <Grid Margin="0,6,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="发现的设备" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="刷新" Style="{StaticResource ToolButton}" Click="OnRefreshLanClick"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding DiscoveredLan}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Address}" FontSize="12"/>
                                                <TextBlock Text="{Binding KindText}" Foreground="{StaticResource SubTextBrush}" FontSize="11"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                                    Content="{Binding ActionText}" Click="OnDiscoveredItemClick"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource SectionLabel}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="列表每 5 秒自动刷新。“待配对”只在手机打开配对对话框时出现；“可连接”对应无线调试主页的地址。"/>

                            <TextBlock Text="配对新设备" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
                            <TextBox x:Name="PairAddressBox" Margin="0,0,0,6"
                                     ToolTip="手机配对对话框里显示的 IP 与配对端口，例如 192.168.1.5:37123"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="PairCodeBox" ToolTip="手机配对对话框里显示的 6 位配对码"/>
                                <Button Grid.Column="1" Content="配对并连接" Style="{StaticResource ToolButton}" Margin="8,0,0,0" Click="OnPairConnectClick"/>
                            </Grid>
                            <TextBlock Style="{StaticResource SectionLabel}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="手机上：开发者选项 → 无线调试 →“使用配对码配对设备”，依次填入配对地址（IP:端口）与配对码。配对码不保存。"/>

                            <TextBlock Text="手动连接（IP:端口）" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="ManualAddressBox" ToolTip="手机“无线调试”主页显示的 IP 与端口，例如 192.168.1.5:41537"/>
                                <Button Grid.Column="1" Content="连接" Style="{StaticResource ToolButton}" Margin="8,0,0,0" Click="OnManualLanConnectClick"/>
                            </Grid>

                            <TextBlock Text="历史设备" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
                            <ItemsControl ItemsSource="{Binding LanHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Foreground="{StaticResource SubTextBrush}" FontSize="11"
                                                           Text="{Binding LastConnectedAt, StringFormat={}{0:MM-dd HH:mm}}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="连接" Style="{StaticResource ToolButton}" Margin="8,0,0,0" Click="OnHistoryConnectClick"/>
                                            <Button Grid.Column="2" Content="删除" Style="{StaticResource ToolButton}" Margin="6,0,0,0" Click="OnHistoryRemoveClick"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <CheckBox IsChecked="{Binding LanAutoReconnect}" Margin="0,8,0,0">
                                <TextBlock Text="断线后自动重连（USB 与局域网；含启动时恢复上次局域网画面）" TextWrapping="Wrap"/>
                            </CheckBox>

                            <TextBlock Text="备用：USB 已授权手机切无线" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="UsbSwitchAddressBox" ToolTip="手机 IP，例如 192.168.1.5（端口默认 5555）"/>
                                <Button Grid.Column="1" Content="切换并连接" Style="{StaticResource ToolButton}" Margin="8,0,0,0" Click="OnUsbSwitchLanClick"/>
                            </Grid>
                            <TextBlock Style="{StaticResource SectionLabel}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="仅限可信局域网使用：手机需正插着数据线且已授权，切换后用其 IP 直连（旧机型配对方式）。"/>
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="ConnectButton" Content="连接" Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding CanConnect}" Click="OnConnectClick" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="断开" IsEnabled="{Binding CanDisconnect}" Click="OnDisconnectClick" Margin="6,0,0,0"/>
                        </Grid>

                        <TextBlock Text="{Binding StatusLine}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}"/>

                        <TextBlock Text="首次使用" Style="{StaticResource SectionLabel}" Margin="0,16,0,0"/>
                        <TextBlock Style="{StaticResource SectionLabel}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="USB：手机开启“开发者选项”与“USB 调试”，数据线连接后在手机授权框勾选“始终允许”。&#10;局域网：手机与电脑同一网络；手机开启“无线调试”，用上面的配对区配一次对，之后进历史设备一键连接。&#10;部分机型还需打开“USB 调试（安全设置）”才能用鼠标操作。手机不需要 Root。"
                                   Foreground="{StaticResource TextBrush}"/>

                        <TextBlock Text="关于音频" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
                        <TextBlock Style="{StaticResource SectionLabel}" TextWrapping="Wrap" Text="当前版本只转发画面与鼠标操作，不转发声音。"

                                   Foreground="{StaticResource TextBrush}"/>

                        <TextBlock Text="内置引擎" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding EngineText}" Style="{StaticResource SectionLabel}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding AdbVersionText}" Style="{StaticResource SectionLabel}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============ 右：画面与交互设置 ============ -->
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="画面与交互" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="质量档位" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                  ItemsSource="{Binding QualityProfiles}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding Quality}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding QualitySummary}" Style="{StaticResource SectionLabel}"
                                   VerticalAlignment="Center" Margin="12,0,0,8" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="渲染后端" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                                  ItemsSource="{Binding RenderDriverOptions}"
                                  SelectedItem="{Binding RenderDriver}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="12,0,0,8" TextWrapping="Wrap"
                                   Text="透明不生效时试 software 或 opengl，需重新连接"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="窗口外观" VerticalAlignment="Top" Margin="0,6,0,0"/>
                        <WrapPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,8">
                            <CheckBox Content="画面窗口无系统边框" IsChecked="{Binding Borderless}" Margin="0,0,16,0"
                                      ToolTip="去掉画面窗口的系统标题栏和边框，改用悬停把手移动与缩放。点一下立刻生效，不用重连。"/>
                            <CheckBox Content="悬停显示拖动把手" IsChecked="{Binding HoverFrameEnabled}" Margin="0,0,16,0"
                                      ToolTip="鼠标停在画面上一会儿后，四边出现把手可拖动缩放。"/>
                            <CheckBox Content="鼠标悬停显示画面" IsChecked="{Binding HoverRevealEnabled}" Margin="0,0,16,0"
                                      ToolTip="画面常态完全透明，鼠标移到画面上才按设定的不透明度显示出来。"/>
                            <CheckBox Content="保持手机常亮" IsChecked="{Binding KeepAwake}" Margin="0,0,16,0"/>
                            <CheckBox Content="工具条跟随画面" IsChecked="{Binding ToolbarFollowsMirror}" Margin="0"/>
                        </WrapPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="置顶 / 穿透" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                            <CheckBox Content="画面置顶" IsChecked="{Binding Topmost}" Margin="0,0,16,0"/>
                            <CheckBox Content="鼠标穿透" IsChecked="{Binding PassThrough}" IsEnabled="{Binding PassThroughEnabled}" Margin="0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                                    Visibility="{Binding HoverRevealEnabled, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="隐藏时的提示" Width="90" VerticalAlignment="Center" Margin="0,0,0,0"/>
                            <ComboBox Width="120" ItemsSource="{Binding HoverRevealHintOptions}"
                                      DisplayMemberPath="DisplayName" SelectedValuePath="Key"
                                      SelectedValue="{Binding HoverRevealHint}"
                                      ToolTip="画面完全看不见时，用什么方式标出它原来的位置"/>
                            <TextBlock Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Text="画面看不见时在这里标出它原来的位置"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding OpacityLabel}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" TickPlacement="BottomRight"
                                IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5"
                                IsEnabled="{Binding OpacityEnabled}"
                                Value="{Binding Opacity, Mode=TwoWay}" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBox Width="52" TextAlignment="Center" Text="{Binding Opacity, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     IsEnabled="{Binding OpacityEnabled}" PreviewTextInput="OnOpacityPreviewInput"/>
                            <TextBlock Text="%" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                <Button Content="0" Tag="0" Style="{StaticResource ToolButton}" Click="OnOpacityPresetClick" IsEnabled="{Binding OpacityEnabled}" Padding="7,4" MinWidth="0"/>
                                <Button Content="25" Tag="25" Style="{StaticResource ToolButton}" Click="OnOpacityPresetClick" IsEnabled="{Binding OpacityEnabled}" Padding="7,4" MinWidth="0" Margin="4,0,0,0"/>
                                <Button Content="50" Tag="50" Style="{StaticResource ToolButton}" Click="OnOpacityPresetClick" IsEnabled="{Binding OpacityEnabled}" Padding="7,4" MinWidth="0" Margin="4,0,0,0"/>
                                <Button Content="75" Tag="75" Style="{StaticResource ToolButton}" Click="OnOpacityPresetClick" IsEnabled="{Binding OpacityEnabled}" Padding="7,4" MinWidth="0" Margin="4,0,0,0"/>
                            </StackPanel>
                            <Button Content="恢复 100" Style="{StaticResource ToolButton}" Click="OnRestoreClick" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="显示工具条" Style="{StaticResource ToolButton}" Click="OnShowToolbarClick"/>
                        <Button Content="验证鼠标穿透" Style="{StaticResource ToolButton}" Click="OnVerifyPassThroughClick" Margin="8,0,0,0"/>
                        <Button Content="应用设置并重连" Style="{StaticResource ToolButton}" Click="OnApplyAndReconnectClick" Margin="8,0,0,0"
                                IsEnabled="{Binding IsConnected}"/>
                        <TextBlock Text="{Binding PassThroughCheck}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource SectionLabel}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="不透明度与鼠标穿透互不影响：半透明时点击仍交给手机；画面为 0% 时会自动不接收点击，但不会改掉你勾选的穿透状态。可随时用工具条、托盘或恢复热键找回画面。"/>

                    <TextBlock Style="{StaticResource SectionLabel}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="质量档位、渲染后端与常亮在连接时生效；连接中修改后点“应用设置并重连”立即生效。无边框与悬停把手点一下就生效。"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="全局快捷键" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="恢复 100" Width="90" VerticalAlignment="Center"/>
                        <TextBox Width="180" Text="{Binding HotkeyRestore, UpdateSourceTrigger=LostFocus}" Tag="restore" KeyDown="OnHotKeyBoxKeyDown"/>
                        <TextBlock Text="穿透切换" Width="90" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <TextBox Width="180" Text="{Binding HotkeyPassThrough, UpdateSourceTrigger=LostFocus}" Tag="passthrough" KeyDown="OnHotKeyBoxKeyDown"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="格式示例 Ctrl+Alt+Shift+R。必须包含 Ctrl/Alt/Shift/Win 之一。修改后失焦生效；若被其它程序占用会提示，托盘入口始终可用。"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="运行诊断" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="环境自检" Style="{StaticResource ToolButton}" Click="OnSelfTestClick" Margin="0,0,8,0"/>
                        <Button Content="复制诊断信息" Style="{StaticResource ToolButton}" Click="OnCopyDiagnosticsClick" Margin="0,0,8,0"/>
                        <Button Content="打开日志目录" Style="{StaticResource ToolButton}" Click="OnOpenLogFolderClick" Margin="0,0,8,0"/>
                        <TextBlock Text="帧率是 scrcpy 引擎输出的解码帧率，不等于屏幕实际呈现帧率" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="引擎帧率" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FpsText}" FontSize="13" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="画面尺寸" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WindowInfo}" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="工具条" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding PassThroughText}" Margin="0,0,10,0"/>
                            <TextBlock Text="·" Foreground="{StaticResource SubTextBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="不透明度" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding OpacityStateText}" Margin="0,0,10,0"/>
                            <TextBlock Text="·" Foreground="{StaticResource SubTextBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="置顶" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding TopmostText}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="版本" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AppVersionText}"/>
                    </Grid>
                    <TextBox x:Name="LogBox" Style="{StaticResource MonoText}" TextWrapping="NoWrap"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ 底部提示条 ============ -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="12,8"
                Background="#FFFFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="3">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="退出程序会同时结束本次画面窗口，不会留下不可见的反控窗口。"
                           Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>