                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Apps.OpacityLabel}" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBox Text="{Binding Apps.Opacity, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="46"
                                                         IsEnabled="{Binding Apps.IsManageEnabled}" PreviewTextInput="OnOpacityPreviewInput"
                                                         AutomationProperties.Name="应用窗口不透明度百分比"/>
