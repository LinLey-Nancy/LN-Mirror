                                                       Style="{StaticResource CenterNote}" FontSize="14" Margin="0,0,0,4"/>
                                            <TextBlock Text="3. 在 LN-Mirror 选择「无线」→「添加设备」，填入手机配对窗口里的 IP:端口和 6 位配对码，点击「配对并连接」。"
                                                       Style="{StaticResource CenterNote}" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="USB 有线连接" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <TextBlock Text="1. 在手机的「开发者选项」中打开「USB 调试」。"
                                                       Style="{StaticResource CenterNote}" FontSize="14" Margin="0,0,0,4"/>
