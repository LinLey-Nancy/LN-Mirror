                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Apps.ImagePath}"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,10,0,0">
                                            <TextBlock Text="图片填充" VerticalAlignment="Center"/>
                                            <views:HelpTip Text="适应保持完整图片并留边；填满保持完整图片并裁掉超出部分；拉伸会改变图片比例；原始大小不缩放。"
                                                           AutomationProperties.Name="图片填充说明"/>
