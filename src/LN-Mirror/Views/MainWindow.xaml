                                            </StackPanel>
                                        </DockPanel>
                                        <Slider Minimum="0" Maximum="100" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding Apps.Opacity, Mode=TwoWay}" IsEnabled="{Binding Apps.IsManageEnabled}"
                                                Style="{StaticResource CenterSlider}" Margin="0,8" AutomationProperties.Name="应用窗口不透明度"/>
                                        <CheckBox Content="窗口置顶" IsChecked="{Binding Apps.Topmost, Mode=TwoWay}"
                                                  IsEnabled="{Binding Apps.IsManageEnabled}" Style="{StaticResource CenterSettingCheck}"/>
                                        <CheckBox Content="隐藏 Alt+Tab / Win+Tab 条目" IsChecked="{Binding Apps.TaskSwitcherHidden, Mode=TwoWay}"
                                                  IsEnabled="{Binding Apps.IsManageEnabled}" Style="{StaticResource CenterSettingCheck}"/>
                                        <TextBlock Style="{StaticResource CenterNote}" Text="隐藏切换器条目通常也会隐藏任务栏按钮；Win+Tab 以具体应用的实际表现为准。"/>
                                    </StackPanel>
                                </Border>

                                <DockPanel Margin="0,12,0,0">
                                    <Button Content="使用管理员权限重试" Style="{StaticResource CenterPrimary}"
                                            Visibility="{Binding Apps.CanRequestElevation, Converter={StaticResource BoolToVis}}"
                                            IsEnabled="{Binding Apps.CanRequestElevation}" Click="OnElevateAppWindowClick"/>
                                    <Button Content="结束管理并恢复" Style="{StaticResource CenterOutline}" HorizontalAlignment="Right"
                                            Click="OnRestoreAppWindowClick" IsEnabled="{Binding Apps.HasTarget}"/>
                                </DockPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="390,0,16,0" Height="46" IsHitTestVisible="False">
            <TextBlock Text="{Binding Notice}" Style="{StaticResource CenterNote}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" ToolTip="{Binding Notice}" AutomationProperties.LiveSetting="Polite"/>
        </Border>
        <Grid x:Name="PairingOverlay" Background="#60172434" Visibility="Collapsed"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
            <Border Width="454" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{StaticResource CenterPanel}" Padding="20" AutomationProperties.Name="配对新设备">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="PairCloseButton" DockPanel.Dock="Right" Content="×" Style="{StaticResource CenterAction}"
                                FontSize="18" AutomationProperties.Name="关闭配对弹窗" Click="OnClosePairingClick"/>
                        <TextBlock Text="配对新设备" Style="{StaticResource CenterSectionTitle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="在手机的「无线调试」中打开「使用配对码配对设备」。"
                               Style="{StaticResource CenterNote}" FontSize="14" Margin="0,0,0,12"/>
                    <StackPanel x:Name="PairFields">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="配对地址"/>
                            <views:HelpTip Text="填写手机配对窗口显示的 IP:端口。配对端口和无线调试主页的端口不是同一个。"
                                           AutomationProperties.Name="配对地址说明"/>
                        </StackPanel>
                        <TextBox x:Name="PairAddressBox" AutomationProperties.Name="配对地址" MinHeight="36"/>
                        <TextBlock Text="配对码" Margin="0,10,0,4"/>
                        <TextBox x:Name="PairCodeBox" AutomationProperties.Name="配对码" MinHeight="36"/>
                    </StackPanel>
                    <TextBlock x:Name="PairingMessage" Style="{StaticResource CenterNote}" Visibility="Collapsed"
                               AutomationProperties.LiveSetting="Polite" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="CancelPairButton" Content="取消" Style="{StaticResource CenterAction}" Click="OnClosePairingClick" Margin="0,0,6,0"/>
                        <Button x:Name="PairSubmitButton" Content="配对并连接" Style="{StaticResource CenterPrimary}" IsDefault="True" Click="OnPairConnectClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
