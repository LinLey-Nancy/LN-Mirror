                                                      ItemsSource="{Binding Apps.ImageStretchOptions}" SelectedItem="{Binding Apps.ImageStretch, Mode=TwoWay}"
                                                      IsEnabled="{Binding Apps.IsManageEnabled}" AutomationProperties.Name="图片填充方式"/>
