                                    <Button Content="打开日志目录" Style="{StaticResource CenterAction}" Click="OnOpenLogFolderClick"/>
                                </WrapPanel>
                                <TextBox x:Name="LogBox" Style="{StaticResource MonoText}" MinHeight="115" MaxHeight="225"
                                         AutomationProperties.Name="运行日志" HorizontalScrollBarVisibility="Auto"/>
                                <Expander Header="引擎信息" Style="{StaticResource CenterDisclosure}" Margin="0,5,0,0">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding EngineText}" Style="{StaticResource CenterNote}"/>
                                        <TextBlock Text="{Binding AdbVersionText}" Style="{StaticResource CenterNote}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
